{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clockit",
  "version": "0.1.0",
  "identifier": "com.clockit.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clockit",
        "width": 960,
        "height": 740,
        "minWidth": 720,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "A focused desktop timer",
    "longDescription": "Clockit is a local-first focus timer and stopwatch with a COSMIC panel tray, a calm forest theme in light and dark, session history, a quick checklist, a mini window, fullscreen focus mode, and private on-device app-usage insights.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
